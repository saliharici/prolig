{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/health",
      "destination": "/api/v1/management?action=health"
    },
    {
      "source": "/api/v1/membership/metadata",
      "destination": "/api/v1/management?action=metadata"
    },
    {
      "source": "/api/v1/membership/applications/:id",
      "destination": "/api/v1/management?action=application&id=:id"
    },
    {
      "source": "/api/v1/membership/applications",
      "destination": "/api/v1/management?action=applications"
    },
    {
      "source": "/api/v1/users/:id",
      "destination": "/api/v1/management?action=user&id=:id"
    },
    {
      "source": "/api/v1/users",
      "destination": "/api/v1/management?action=users"
    },
    {
      "source": "/api/v1/payments/:id/approve",
      "destination": "/api/v1/payments?action=approve&id=:id"
    },
    {
      "source": "/api/v1/payments/:id/pay",
      "destination": "/api/v1/payments?action=pay&id=:id"
    },
    {
      "source": "/api/v1/questions/:id/workflow",
      "destination": "/api/v1/questions/[id]/workflow"
    },
    {
      "source": "/api/v1/questions/:id",
      "destination": "/api/v1/questions/[id]"
    },
    {
      "source": "/api/v1/authors/:id",
      "destination": "/api/v1/authors/[id]"
    },
    {
      "source": "/api/v1/projects/:id",
      "destination": "/api/v1/projects/[id]"
    },
    {
      "source": "/api/v1/personal-question-sets/:id/docx",
      "destination": "/api/v1/management?action=personalQuestionSetDocx&id=:id"
    },
    {
      "source": "/api/v1/personal-question-sets/:id",
      "destination": "/api/v1/management?action=personalQuestionSet&id=:id"
    },
    {
      "source": "/api/v1/personal-question-sets",
      "destination": "/api/v1/management?action=personalQuestionSets"
    },
    {
      "source": "/api/v1/personal-questions/:id/publish-copy",
      "destination": "/api/v1/management?action=personalQuestionPublishCopy&id=:id"
    },
    {
      "source": "/api/v1/books/:id/docx",
      "destination": "/api/v1/management?action=bookDocx&id=:id"
    },
    {
      "source": "/api/v1/books/:id",
      "destination": "/api/v1/management?action=book&id=:id"
    },
    {
      "source": "/api/v1/books",
      "destination": "/api/v1/management?action=books"
    },
    {
      "source": "/api/v1/tasks/:id",
      "destination": "/api/v1/management?action=task&id=:id"
    },
    {
      "source": "/api/v1/tasks",
      "destination": "/api/v1/management?action=tasks"
    },
    {
      "source": "/api/v1/compensation/periods/:id/prepare",
      "destination": "/api/v1/management?action=paymentPeriodPrepare&id=:id"
    },
    {
      "source": "/api/v1/compensation/periods/:id/settle",
      "destination": "/api/v1/management?action=paymentPeriodSettle&id=:id"
    },
    {
      "source": "/api/v1/compensation/periods/:id/close",
      "destination": "/api/v1/management?action=paymentPeriodClose&id=:id"
    },
    {
      "source": "/api/v1/compensation/periods/:id/cancel",
      "destination": "/api/v1/management?action=paymentPeriodCancel&id=:id"
    },
    {
      "source": "/api/v1/compensation/periods/:id",
      "destination": "/api/v1/management?action=paymentPeriod&id=:id"
    },
    {
      "source": "/api/v1/compensation/periods",
      "destination": "/api/v1/management?action=paymentPeriods"
    },
    {
      "source": "/api/v1/payments/:id/cancel",
      "destination": "/api/v1/payments?action=cancel&id=:id"
    },
    {
      "source": "/api/v1/compensation/entries",
      "destination": "/api/v1/management?action=compensationEntries"
    },
    {
      "source": "/api/v1/compensation/rules/:id",
      "destination": "/api/v1/management?action=compensationRule&id=:id"
    },
    {
      "source": "/api/v1/compensation/rules",
      "destination": "/api/v1/management?action=compensationRules"
    },
    {
      "source": "/api/v1/audit-logs",
      "destination": "/api/v1/management?action=auditLogs"
    },
    {
      "source": "/api/v1/messages/recipients",
      "destination": "/api/v1/management?action=messageRecipients"
    },
    {
      "source": "/api/v1/messages/:id",
      "destination": "/api/v1/management?action=message&id=:id"
    },
    {
      "source": "/api/v1/messages",
      "destination": "/api/v1/management?action=messages"
    },
    {
      "source": "/api/v1/announcements/:id",
      "destination": "/api/v1/management?action=announcement&id=:id"
    },
    {
      "source": "/api/v1/announcements",
      "destination": "/api/v1/management?action=announcements"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feat/p2-professional-question-editor-20261012": false,
      "feature/corporate-landing-v1-20261014": false
    }
  }
}
