// Prisma schema for PRO LİG - Profesyoneller Karması
// Designed for PostgreSQL on Vercel (Neon / Supabase / RDS)

datasource db {
  provider = "postgresql"
  
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

enum RoleCode {
  GENEL_KOORDINATOR
  BOLGE_KOORDINATORU
  IL_KOORDINATORU
  EDITOR
  YAZAR
  MUHASEBE
}

enum AuthorStatus {
  Aktif
  Pasif
  Beklemede
  Arsiv
}

enum ProjectStatus {
  Taslak
  Planlama
  Devam_Ediyor
  Kontrol
  Tamamlandi
  Arsiv
}

enum TaskStatus {
  Bekliyor
  Devam_Ediyor
  Kontrol_Bekliyor
  Tamamlandi
  Gecikti
}

enum Priority {
  Dusuk
  Normal
  Yuksek
  Acil
}

enum PaymentStatus {
  Bekliyor
  Onaylandi
  Odendi
  Iptal
}

enum QuestionStatus {
  TASLAK
  INCELEMEDE
  REVIZYON
  ONAYLANDI
  REDDEDILDI
}

model Role {
  id          Int      @id @default(autoincrement())
  code        RoleCode @unique
  name        String
  description String?
  permissions String[] @default([])
  users       User[]
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  email          String    @unique
  passwordHash   String?
  fullName       String
  roleId         Int
  role           Role      @relation(fields: [roleId], references: [id])
  assignedRegion String? // Bölge KoordinatörünÃ¼n sorumlu olduÄŸu bÃ¶lge (Ã¶rn: 'Marmara')
  provinceId     Int?
  province       Province? @relation(fields: [provinceId], references: [id])
  avatarUrl      String?
  phone          String?
  status         String    @default("Aktif")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  notifications    Notification[]
  assignedTasks    Task[]         @relation("CoordinatorTasks")

  AuthorProfile AuthorProfile?
  Payment       Payment[]
  Question      Question[]

  @@index([email])
}

model Province {
  id             Int             @id
  code           String          @unique
  name           String          @unique
  region         String
  districts      District[]
  authorProfiles AuthorProfile[]
  institutions   Institution[]
  users          User[]

  @@index([name])
}

model District {
  id             Int             @id @default(autoincrement())
  provinceId     Int
  province       Province        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name           String
  authorProfiles AuthorProfile[]

  @@index([provinceId])
}

model Branch {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  category       String
  color          String          @default("#2563eb")
  authorProfiles AuthorProfile[]
  projects       Project[]
}

model Institution {
  id             Int             @id @default(autoincrement())
  name           String
  provinceId     Int
  province       Province        @relation(fields: [provinceId], references: [id])
  type           String          @default("Devlet Okulu")
  authorProfiles AuthorProfile[]
}

model AuthorProfile {
  id              Int          @id @default(autoincrement())
  userId          Int          @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  profilePhoto    String?
  provinceId      Int
  province        Province     @relation(fields: [provinceId], references: [id])
  districtId      Int?
  district        District?    @relation(fields: [districtId], references: [id])
  branchId        Int
  branch          Branch       @relation(fields: [branchId], references: [id])
  institutionId   Int?
  institution     Institution? @relation(fields: [institutionId], references: [id])
  title           String       @default("Yazar / Öğretmen")
  experienceYears Int          @default(5)
  status          AuthorStatus @default(Aktif)
  biography       String?
  iban            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  projectAuthors ProjectAuthor[]
  tasks          Task[]
  files          FileRecord[]

  // Havuz sistemi hakedişleri iÃ§in Puan/Kredi sistemi
  points Int @default(0)

  @@index([provinceId])
  @@index([branchId])
  @@index([status])
}

model Project {
  id            Int           @id @default(autoincrement())
  title         String
  code          String        @unique
  projectType   String        @default("Soru Bankası")
  coordinatorId Int?
  progress      Int           @default(0)
  deadline      DateTime
  status        ProjectStatus @default(Devam_Ediyor)
  priority      Priority      @default(Normal)
  targetGrade   String        @default("8. Sınıf")
  branchId      Int
  branch        Branch        @relation(fields: [branchId], references: [id])
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  books          Book[]
  projectAuthors ProjectAuthor[]
  tasks          Task[]
  files          FileRecord[]

  Payment  Payment[]
  Question Question[]

  @@index([status])
  @@index([deadline])
}

model Book {
  id              Int       @id @default(autoincrement())
  projectId       Int
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  isbn            String?
  pageCount       Int       @default(240)
  status          String    @default("Dizgi Aşamasında")
  publicationDate DateTime?
}

model ProjectAuthor {
  id               Int           @id @default(autoincrement())
  projectId        Int
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorProfileId Int
  authorProfile    AuthorProfile @relation(fields: [authorProfileId], references: [id], onDelete: Cascade)
  roleInProject    String        @default("Yazar")
  assignedChapters String?
  createdAt        DateTime      @default(now())

  @@unique([projectId, authorProfileId])
}

model Task {
  id                    Int            @id @default(autoincrement())
  title                 String
  description           String?
  assignedAuthorProfileId Int?
  assignedAuthorProfile AuthorProfile? @relation(fields: [assignedAuthorProfileId], references: [id])
  assignedCoordinatorId Int?
  assignedCoordinator   User?          @relation("CoordinatorTasks", fields: [assignedCoordinatorId], references: [id])
  projectId             Int
  project               Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  priority              Priority       @default(Normal)
  status                TaskStatus     @default(Bekliyor)
  startDate             DateTime       @default(now())
  dueDate               DateTime
  completionDate        DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([status])
  @@index([dueDate])
}

model Payment {
  id           Int           @id @default(autoincrement())
  authorUserId Int
  authorUser   User          @relation(fields: [authorUserId], references: [id])
  projectId    Int?
  project      Project?      @relation(fields: [projectId], references: [id])
  contractNo   String?
  amount       Decimal       @db.Decimal(12, 2)
  status       PaymentStatus @default(Bekliyor)
  paymentDate  DateTime?
  invoiceNo    String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
}

model FileRecord {
  id            Int            @id @default(autoincrement())
  filename      String
  fileSize      Int
  fileType      String
  fileUrl       String
  uploaderName  String
  projectId     Int?
  project       Project?       @relation(fields: [projectId], references: [id])
  authorProfileId Int?
  authorProfile AuthorProfile? @relation(fields: [authorProfileId], references: [id])
  category      String         @default("Taslak Soru")
  uploadDate    DateTime       @default(now())
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  subject    String
  body       String
  isRead     Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([receiverId, isRead])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  priority    Priority @default(Normal)
  audience    String   @default("Tümü")
  publishedAt DateTime @default(now())
  isArchived  Boolean  @default(false)
  createdBy   String   @default("Yönetim")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("system")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  userName   String
  action     String
  entityType String
  entityId   Int?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Question {
  id           Int     @id @default(autoincrement())
  content      String // Metin veya Soru iÃ§eriÄŸi
  imageUrl     String? // Ä°steÄŸe baÄŸlÄ± soru resmi
  authorUserId Int
  authorUser   User    @relation(fields: [authorUserId], references: [id])

  // Havuz sistemi: Soru havuza baÄŸÄ±msÄ±z dÃ¼ÅŸer, sonradan kitaba Ã§ekilir.
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])

  // Taksonomi (MEB Kategorizasyonu)
  objectiveCode String? // KazanÄ±m Kodu (Ã–rn: M.8.1.2.1)
  grade         String? // SÄ±nÄ±f (Ã–rn: 8. Sınıf)
  difficulty    String? // Zorluk (Ã–rn: Kolay, Orta, Zor)

  status     QuestionStatus @default(TASLAK)
  editorNote String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([authorUserId])
  @@index([projectId])
  @@index([status])
}


