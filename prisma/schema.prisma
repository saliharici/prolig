generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GENEL_KOORDINATOR
  IL_KOORDINATORU
  EDITOR
  YAZAR
  MUHASEBE
  YONETICI
}

enum AuthorStatus {
  AKTIF
  PASIF
  BEKLEMEDE
  ARSIV
}

enum ProjectStatus {
  TASLAK
  PLANLAMA
  DEVAM_EDIYOR
  KONTROL
  TAMAMLANDI
  ARSIV
}

enum TaskStatus {
  BEKLIYOR
  DEVAM_EDIYOR
  KONTROL_BEKLIYOR
  TAMAMLANDI
  GECIKTI
}

enum Priority {
  DUSUK
  NORMAL
  YUKSEK
  ACIL
}

enum PaymentStatus {
  BEKLIYOR
  ONAYLANDI
  ODENDI
  IPTAL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role      @default(YAZAR)
  profilePhoto  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  authorProfile Author?   
  assignedTasks Task[]    @relation("CoordinatorTasks")
  messagesSent  Message[] @relation("SentMessages")
  messagesRecv  Message[] @relation("ReceivedMessages")
  notifications Notification[]
  activityLogs  ActivityLog[]
}

model Province {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  authors   Author[]
  districts District[]
}

model District {
  id         Int      @id @default(autoincrement())
  name       String
  provinceId Int
  province   Province @relation(fields: [provinceId], references: [id])
  authors    Author[]
}

model Branch {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  authors Author[]
}

model Institution {
  id      Int      @id @default(autoincrement())
  name    String
  authors Author[]
}

model Author {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provinceId    Int?
  province      Province?    @relation(fields: [provinceId], references: [id])
  districtId    Int?
  district      District?    @relation(fields: [districtId], references: [id])
  branchId      Int?
  branch        Branch?      @relation(fields: [branchId], references: [id])
  institutionId Int?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  title         String?
  experience    Int?         
  status        AuthorStatus @default(BEKLEMEDE)
  biography     String?      @db.Text
  phone         String?

  projects      ProjectAuthor[]
  tasks         Task[]       @relation("AuthorTasks")
  payments      Payment[]
  files         File[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  type        String    
  status      ProjectStatus @default(TASLAK)
  priority    Priority  @default(NORMAL)
  deadline    DateTime?
  progress    Int       @default(0) 

  authors     ProjectAuthor[]
  tasks       Task[]
  payments    Payment[]
  files       File[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProjectAuthor {
  id        String  @id @default(cuid())
  projectId String
  authorId  String
  roleInProject String? 

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, authorId])
}

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String?    @db.Text
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId      String?
  author        Author?    @relation("AuthorTasks", fields: [authorId], references: [id])
  coordinatorId String?
  coordinator   User?      @relation("CoordinatorTasks", fields: [coordinatorId], references: [id])

  status        TaskStatus @default(BEKLIYOR)
  priority      Priority   @default(NORMAL)
  startDate     DateTime?
  dueDate       DateTime?
  completedDate DateTime?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Payment {
  id          String    @id @default(cuid())
  authorId    String
  author      Author    @relation(fields: [authorId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  amount      Decimal   @db.Decimal(10, 2)
  status      PaymentStatus @default(BEKLIYOR)
  paymentDate DateTime?
  notes       String?   @db.Text
  documentUrl String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model File {
  id        String   @id @default(cuid())
  filename  String
  url       String
  type      String
  size      Int      
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  authorId  String?
  author    Author?  @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  subject    String?
  content    String   @db.Text
  isRead     Boolean  @default(false)
  isArchived Boolean  @default(false)

  createdAt  DateTime @default(now())
}

model Announcement {
  id           String   @id @default(cuid())
  title        String
  content      String   @db.Text
  priority     Priority @default(NORMAL)
  publishDate  DateTime @default(now())
  isArchived   Boolean  @default(false)
  targetAudience String? 

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  isRead    Boolean  @default(false)
  link      String?

  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   
  entityType String  
  entityId   String
  details   String?  @db.Text

  createdAt DateTime @default(now())
}