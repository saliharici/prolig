# ==============================================================================
# PRO-LIG CANONICAL ENVIRONMENT SETTINGS
# ==============================================================================
# 
# This file provides placeholdered variables for the local development environment.
# Do NOT place real secrets in this file. 

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# The base URL of the application
APP_URL="http://localhost:3000"

# Server-side API key for Google Gemini operations
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# DATABASE SETTINGS
# ------------------------------------------------------------------------------
# The primary runtime connection. Typically a pooled connection string.
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require&pgbouncer=true"

# The direct connection used exclusively by Prisma CLI for migrations.
DIRECT_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require"

# ------------------------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used for signing HS256 JWTs.
AUTH_SECRET="your_strong_random_secret_here"

# ------------------------------------------------------------------------------
# DB SAFETY GATES
# ------------------------------------------------------------------------------
# Must be strictly explicitly set to "true" to allow database mutations via the
# operator integration suite or seed scripts.
PROLIG_PILOT_DB_CONFIRMED="false"

# Must be explicitly set to "true" to allow rotating existing Pilot passwords during seed.
PROLIG_ROTATE_PILOT_PASSWORDS="false"
